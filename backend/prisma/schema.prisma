generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model deck {
  id                            Int                @id @default(autoincrement())
  name                          String             @default("Untitled Deck") @db.VarChar(100)
  user_id                       Int
  win_cnt                       Int                @default(0)
  lose_cnt                      Int                @default(0)
  total_p_val                   Int                @default(0)
  created_at                    DateTime           @default(now()) @db.Timestamp(6)
  user                          user               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_deck_user")
  deck_composition              deck_composition[]
  game_game_black_deck_idTodeck game[]             @relation("game_black_deck_idTodeck")
  game_game_white_deck_idTodeck game[]             @relation("game_white_deck_idTodeck")

  @@index([user_id], map: "idx_deck_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model deck_composition {
  id       Int    @id @default(autoincrement())
  deck_id  Int
  piece_id Int
  position String @db.VarChar(2)  // e.g., "e1", "a2"
  deck     deck   @relation(fields: [deck_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_deck_composition_deck")
  piece    piece  @relation(fields: [piece_id], references: [id], onUpdate: NoAction, map: "fk_deck_composition_piece")

  @@unique([deck_id, position])
  @@index([deck_id], map: "idx_deck_composition_deck")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model game {
  id                              Int            @id @default(autoincrement())
  white_player_id                 Int
  black_player_id                 Int
  initial_fen                     String?        @db.VarChar(255)
  pgn                             String?
  result                          String?        @db.VarChar(20)
  white_deck_id                   Int
  black_deck_id                   Int
  played_at                       DateTime       @default(now()) @db.Timestamp(6)
  rating_changes                  Json?
  deck_game_black_deck_idTodeck   deck           @relation("game_black_deck_idTodeck", fields: [black_deck_id], references: [id], onUpdate: NoAction, map: "fk_game_black_deck")
  user_game_black_player_idTouser user           @relation("game_black_player_idTouser", fields: [black_player_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_game_black_player")
  deck_game_white_deck_idTodeck   deck           @relation("game_white_deck_idTodeck", fields: [white_deck_id], references: [id], onUpdate: NoAction, map: "fk_game_white_deck")
  user_game_white_player_idTouser user           @relation("game_white_player_idTouser", fields: [white_player_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_game_white_player")
  game_history                    game_history[]

  @@index([black_player_id], map: "idx_game_black_player")
  @@index([played_at(sort: Desc)], map: "idx_game_played_at")
  @@index([white_player_id], map: "idx_game_white_player")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model game_history {
  user_id       Int
  game_id       Int
  role          String  @db.VarChar(20)
  result        String? @db.VarChar(20)
  rating_change Float?  @default(0)
  piece_score   Int?
  game          game    @relation(fields: [game_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_game_history_game")
  user          user    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_game_history_user")

  @@id([user_id, game_id])
  @@index([user_id], map: "idx_game_history_user")
}

model piece {
  id               Int                @id @default(autoincrement())
  name             String             @unique(map: "idx_piece_name") @db.VarChar(50)
  value            Int
  action           String             @db.VarChar(255)
  img_url          String?            @db.VarChar(500)
  deck_composition deck_composition[]
}

model user {
  id                              Int            @id @default(autoincrement())
  username                        String         @unique @db.VarChar(255)
  rating                          Float          @default(1500.0)
  rd                              Float          @default(350.0)
  volatility                      Float          @default(0.06)
  last_game_at                    DateTime?      @db.Timestamp(6)
  email                           String?        @unique @db.VarChar(255)
  google_id                       String?        @unique @db.VarChar(255)
  picture                         String?        @db.VarChar(500)
  created_at                      DateTime       @default(now()) @db.Timestamp(6)
  deck                            deck[]
  game_game_black_player_idTouser game[]         @relation("game_black_player_idTouser")
  game_game_white_player_idTouser game[]         @relation("game_white_player_idTouser")
  game_history                    game_history[]

  @@index([rating(sort: Desc)], map: "idx_user_rating")
  @@index([username], map: "idx_user_username")
  @@index([email], map: "idx_user_email")
  @@index([google_id], map: "idx_user_google_id")
}
